# ===================== LLM Provider 配置 =====================
# 默认使用的 LLM 提供商: deepseek | qwen | moonshot | glm | baidu | ollama | openai | anthropic
DEFAULT_LLM_PROVIDER=deepseek

# --- DeepSeek (深度求索, OpenAI 兼容) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 通义千问 Qwen (阿里云百炼, OpenAI 兼容) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- Moonshot Kimi (月之暗面, OpenAI 兼容) ---
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# --- 智谱 GLM (OpenAI 兼容) ---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4

# --- 百度千帆 (OpenAI 兼容) ---
BAIDU_API_KEY=
BAIDU_BASE_URL=https://qianfan.baidubce.com/v2
BAIDU_MODEL=ernie-4.0-8k

# --- 本地 Ollama (OpenAI 兼容) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# LLM 通用参数
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE_GENERATE=0.8
LLM_TEMPERATURE_MUTATE=0.6
LLM_TEMPERATURE_ANALYZE=0.3
LLM_REQUEST_TIMEOUT=120

# ===================== 数据源配置 =====================
TUSHARE_TOKEN=
# 数据源优先顺序: tushare | akshare (akshare 为免费源)
PRIMARY_DATA_PROVIDER=tushare

# ===================== 数据库配置 =====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_quant
POSTGRES_USER=ai_quant_user
POSTGRES_PASSWORD=AiQuant2024!

# ===================== Redis 配置 =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===================== Web 配置 =====================
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_USERNAME=admin
WEB_PASSWORD=admin123

# ===================== 系统配置 =====================
LOG_LEVEL=INFO
MAX_STRATEGIES=20
INITIAL_CAPITAL=100000
COMMISSION_RATE=0.0003
SLIPPAGE=0.001
MIN_SHARPE_FOR_PASS=0.3
MIN_WIN_RATE=0.45
HISTORY_VALIDATION_YEARS=3
MAX_CONDITIONS=8

# ===================== 进化配置 =====================
EVOLUTION_CYCLE_DAYS=7
EVOLUTION_ELIMINATION_RATE=0.20
EVOLUTION_ELITE_COUNT=3
EVOLUTION_MUTANTS_PER_ELITE=2
EVOLUTION_NEW_STRATEGIES_PER_CYCLE=3
EVOLUTION_ENABLE_CROSSOVER=true

# ===================== 告警配置 =====================
DINGTALK_WEBHOOK=
EMAIL_ALERT=
ALERT_MAX_DRAWDOWN=-0.20
ALERT_DAILY_LOSS=-0.05
ALERT_CONSECUTIVE_LOSS_DAYS=5

# ===================== 知识库配置 =====================
# 向量库持久化目录
CHROMA_PERSIST_PATH=./data/chroma
# Embedding: builtin(轻量哈希,无需下载) 或 sentence-transformers 模型名(如 BAAI/bge-large-zh-v1.5)
EMBEDDING_MODE=builtin
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
